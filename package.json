{
  "name": "mwd-aiom",
  "version": "0.1.0",
  "private": true,
  "description": "Source repository for the AIOM Core Seed and Minimal Executable Kernel — a human-governed, AI-assisted operating architecture for bootstrapping, governing, validating, resuming, and evolving digital-product and automation work.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "exports": {
    ".": {
      "types": "./dist/invocation/index.d.ts",
      "default": "./dist/invocation/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mwd-aiom": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "seed"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli/main.js",
    "test": "vitest run",
    "validate": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "validate:pr-attribution": "node scripts/validate-pr-attribution.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.3.0",
    "zod": "^4.4.3"
  }
}
